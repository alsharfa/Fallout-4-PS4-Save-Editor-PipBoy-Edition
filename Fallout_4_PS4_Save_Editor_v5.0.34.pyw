    sys.path.insert(0,str(root))
    runpy.run_path(str(root/'Fallout4_Simple_Save_Editor.pyw'),run_name='__main__')
def _show_startup_error():
    detail=traceback.format_exc()
    try:
        log=Path(tempfile.gettempdir())/'Fallout_4_PS4_Save_Editor_startup_error.txt'
        log.write_text(detail,encoding='utf-8')
    except Exception:log=None
    try:
        import tkinter as tk
        from tkinter import messagebox
        app=tk.Tk();app.withdraw()
        suffix=f'\n\nError log: {log}' if log else ''
        messagebox.showerror(APP_NAME,f'The editor could not start.\n\n{detail}{suffix}')
        app.destroy()
    except Exception:
        try:sys.stderr.write(detail)
        except Exception:pass
if __name__=='__main__':
    try:_main()
    except Exception:_show_startup_error()