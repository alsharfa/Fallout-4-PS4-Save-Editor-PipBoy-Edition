def _cache_root() -> Path:
    if os.name == "nt":
        base = os.environ.get("LOCALAPPDATA") or os.environ.get("TEMP")
        if base:
            return Path(base) / "Fallout_4_PS4_Save_Editor_PipBoy_Edition"
    return Path(tempfile.gettempdir()) / "Fallout_4_PS4_Save_Editor_PipBoy_Edition"


def _prepare_runtime() -> Path:
    payload = base64.b64decode(_PAYLOAD_B64)
    digest = hashlib.sha256(payload).hexdigest()
    if digest != PAYLOAD_SHA256:
        raise RuntimeError("Embedded runtime failed the integrity check.")

    runtime = _cache_root() / f"v{APP_VERSION}_{PAYLOAD_SHA256[:12]}"
    marker = runtime / ".ready"
    if marker.exists() and (runtime / "Fallout4_Simple_Save_Editor.pyw").exists():
        return runtime

    staging = runtime.with_name(runtime.name + ".tmp")
    if staging.exists():
        shutil.rmtree(staging, ignore_errors=True)
    staging.mkdir(parents=True, exist_ok=True)
    with zipfile.ZipFile(BytesIO(payload), "r") as zf:
        for member in zf.infolist():
            target = (staging / member.filename).resolve()
            if staging.resolve() not in target.parents and target != staging.resolve():
                raise RuntimeError("Invalid embedded runtime path.")
        zf.extractall(staging)
    marker_tmp = staging / ".ready"
    marker_tmp.write_text(PAYLOAD_SHA256, encoding="ascii")
    runtime.parent.mkdir(parents=True, exist_ok=True)
    if runtime.exists():
        shutil.rmtree(runtime, ignore_errors=True)
    staging.replace(runtime)
    return runtime


def main() -> None:
    if sys.version_info < (3, 10):
        raise SystemExit("Fallout 4 PS4 Save Editor PipBoy edition requires Python 3.10 or newer.")
    runtime = _prepare_runtime()
    sys.path.insert(0, str(runtime))
    runpy.run_path(str(runtime / "Fallout4_Simple_Save_Editor.pyw"), run_name="__main__")


if __name__ == "__main__":
    main()