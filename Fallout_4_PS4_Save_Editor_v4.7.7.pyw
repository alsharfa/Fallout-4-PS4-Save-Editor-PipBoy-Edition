    if hashlib.sha256(payload).hexdigest()!=PAYLOAD_SHA256:
        raise RuntimeError("Embedded editor payload checksum mismatch.")
    root=Path(tempfile.gettempdir())/'Fallout_4_PS4_Save_Editor'/f'v{APP_VERSION}_{PAYLOAD_SHA256[:12]}'
